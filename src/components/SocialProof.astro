---
import { sitio } from "../data/sitio.js";

const entidades = sitio.validoAnte.split(" · ");
---

<section class="prueba-social seccion-borde-superior fade-in-scroll">
  <h2 class="sr-only">Experiencia y respaldo profesional</h2>
  <div class="curvas-nivel-fondo curvas-nivel-fondo--sutil curvas-nivel-fondo--clara" aria-hidden="true"></div>
  <div class="contenedor prueba-social__grid">
    <div class="prueba-social__stat">
      <span class="prueba-social__numero">{sitio.aniosExperiencia}+</span>
      <span class="prueba-social__etiqueta">años midiendo la región</span>
    </div>

    <div class="prueba-social__bloque">
      <span class="prueba-social__etiqueta">Válido ante</span>
      <div class="prueba-social__chips">
        {entidades.map((entidad) => (
          <span class="prueba-social__chip">{entidad}</span>
        ))}
      </div>
    </div>

    <div class="prueba-social__bloque">
      <span class="prueba-social__etiqueta">Cobertura</span>
      <p class="prueba-social__cobertura">
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" focusable="false">
          <path d="M10 18s6-6.2 6-10.4A6 6 0 104 7.6C4 11.8 10 18 10 18z" fill="none" stroke="currentColor" stroke-width="1.4" />
          <circle cx="10" cy="7.4" r="2" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        {sitio.cobertura}
      </p>
    </div>
  </div>
</section>

<style>
  .prueba-social {
    padding-block: 3rem;
    background: var(--color-principal);
    color: #fff;
  }

  .prueba-social__grid {
    display: grid;
    gap: 2rem;
  }

  .prueba-social__etiqueta {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b7c0d1;
    margin-bottom: 0.5rem;
  }

  .prueba-social__numero {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.2rem);
    line-height: 1;
    color: var(--color-acento);
  }

  .prueba-social__stat .prueba-social__etiqueta {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .prueba-social__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .prueba-social__chip {
    padding: 0.3em 0.75em;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    font-size: 0.82rem;
  }

  .prueba-social__cobertura {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    color: #e7e9ee;
  }

  .prueba-social__cobertura svg {
    color: var(--color-acento);
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .prueba-social__grid {
      grid-template-columns: auto 1fr 1fr;
      align-items: start;
    }
  }
</style>
