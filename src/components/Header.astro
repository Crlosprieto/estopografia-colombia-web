---
import { sitio, whatsappUrl } from "../data/sitio.js";
import OptImage from "./OptImage.astro";
<meta name="google-site-verification" content="dfh8Cik54yjxu6PjiaqaSOB5G2lGM8pomWudBoCukYg" />

const enlaces = [
  { numero: "01", texto: "Casos", href: "#casos" },
  { numero: "02", texto: "Sobre mí", href: "#sobre-mi" },
  { numero: "03", texto: "Equipos", href: "#equipos" },
  { numero: "04", texto: "Trabajos", href: "#trabajos" },
  { numero: "05", texto: "Contacto", href: "#contacto" },
];
---

<header class="header" id="header-sitio">
  <meta name="google-site-verification" content="dfh8Cik54yjxu6PjiaqaSOB5G2lGM8pomWudBoCukYg" />
  <div class="contenedor header__barra">
    <a href="#contenido" class="header__marca">
      <OptImage
        nombre={sitio.logo}
        alt={`Logo de ${sitio.nombreComercial}`}
        width={60}
        height={60}
        loading="eager"
        style="width: 52px; flex-shrink: 0;"
      />
      <span class="header__nombre">{sitio.nombreComercial}</span>
    </a>

    <button
      class="header__toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="sr-only">Abrir menú</span>
      <span class="header__icono" aria-hidden="true"></span>
    </button>

    <noscript>
      <style>
        /* Sin JavaScript no hay forma de "abrir" el menú: se muestra siempre,
           como bloque normal en vez de panel superpuesto. */
        #menu-toggle {
          display: none;
        }
        #menu-principal {
          position: static !important;
          opacity: 1 !important;
          visibility: visible !important;
          transform: none !important;
          padding: 1.5rem !important;
        }
      </style>
    </noscript>

    <div class="header__nav-envoltura" id="menu-principal">
      <div class="curvas-nivel-fondo curvas-nivel-fondo--sutil" aria-hidden="true"></div>
      <nav class="header__nav" aria-label="Navegación principal">
        {enlaces.map((enlace) => (
          <a href={enlace.href} data-nav-enlace>
            <span class="header__nav-numero" aria-hidden="true">{enlace.numero}</span>
            {enlace.texto}
          </a>
        ))}
      </nav>
      <a class="btn btn-primario header__cta" href={whatsappUrl(sitio.mensajeWhatsAppGenerico)} target="_blank" rel="noopener noreferrer">
        Hablemos por WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 450ms ease, border-color 450ms ease, box-shadow 450ms ease,
      padding-block 300ms ease;
  }

  .header.header--scrolled {
    background: rgba(248, 247, 244, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom-color: var(--color-borde);
    box-shadow: 0 12px 30px -22px rgba(20, 24, 31, 0.35);
  }

  .header__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    transition: padding-block 300ms ease;
  }

  .header--scrolled .header__barra {
    padding-block: 0.6rem;
  }

  .header__marca {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .header__nombre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.82rem, 3.2vw, 1.05rem);
    color: var(--color-principal);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .header__toggle {
    position: relative;
    z-index: 46;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    cursor: pointer;
    flex-shrink: 0;
  }

  .header__icono,
  .header__icono::before,
  .header__icono::after {
    display: block;
    width: 1.15rem;
    height: 1.5px;
    background: var(--color-principal);
    position: relative;
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .header__icono::before,
  .header__icono::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .header__icono::before {
    top: -5px;
  }

  .header__icono::after {
    top: 5px;
  }

  .header__toggle[aria-expanded="true"] .header__icono {
    background: transparent;
  }

  .header__toggle[aria-expanded="true"] .header__icono::before {
    top: 0;
    transform: rotate(45deg);
  }

  .header__toggle[aria-expanded="true"] .header__icono::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .header__nav-envoltura {
    position: fixed;
    inset: 0;
    top: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    gap: 2.5rem;
    padding: 6rem 1.5rem 3rem;
    background: var(--color-bg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 350ms ease, transform 350ms ease, visibility 0s linear 350ms;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .header__nav-envoltura.es-abierto {
    z-index: 45;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 350ms ease, transform 350ms ease, visibility 0s linear 0s;
  }

  .header__nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header__nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    text-decoration: none;
    color: var(--color-principal);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    font-weight: 600;
    border-top: 1px solid var(--color-borde);
    transition: color var(--transicion), padding-left 300ms ease;
  }

  .header__nav a:first-child {
    border-top: none;
  }

  .header__nav-numero {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-acento);
    letter-spacing: 0.04em;
  }

  .header__nav a:hover,
  .header__nav a.es-activo {
    color: var(--color-acento);
    padding-left: 0.5rem;
  }

  .header__cta {
    align-self: flex-start;
  }

  @media (min-width: 768px) {
    .header__toggle {
      display: none;
    }

    .header__nav-envoltura {
      position: static;
      z-index: auto;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: 2.25rem;
      padding: 0;
      background: transparent;
      opacity: 1;
      visibility: visible;
      transform: none;
      overflow: visible;
      transition: none;
    }

    .header__nav-envoltura .curvas-nivel-fondo {
      display: none;
    }

    .header__nav {
      flex-direction: row;
      align-items: center;
      gap: 1.85rem;
    }

    .header__nav a {
      position: relative;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 0.15rem;
      padding: 0.3rem 0;
      border-top: none;
      font-family: var(--font-body);
      font-size: 0.92rem;
      font-weight: 500;
    }

    .header__nav a:hover,
    .header__nav a.es-activo {
      padding-left: 0;
    }

    .header__nav-numero {
      font-size: 0.65rem;
    }

    .header__nav a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -3px;
      width: 100%;
      height: 1.5px;
      background: var(--color-acento);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transicion);
    }

    .header__nav a:hover::after,
    .header__nav a.es-activo::after {
      transform: scaleX(1);
    }

    .header__nav a.es-activo .header__nav-numero {
      color: var(--color-principal);
    }

    .header__cta {
      align-self: auto;
      padding: 0.6em 1.3em;
      font-size: 0.88rem;
    }
  }
</style>

<script>
  const header = document.getElementById("header-sitio");
  const boton = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu-principal");

  // Superficie del header: transparente arriba, sólida al bajar.
  let activo = false;
  function actualizarSuperficie() {
    const debeActivarse = window.scrollY > 24;
    if (debeActivarse !== activo) {
      activo = debeActivarse;
      header?.classList.toggle("header--scrolled", activo);
    }
  }
  actualizarSuperficie();
  window.addEventListener("scroll", actualizarSuperficie, { passive: true });

  // Menú móvil.
  function cerrarMenu() {
    menu?.classList.remove("es-abierto");
    boton?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  boton?.addEventListener("click", () => {
    const abierto = menu?.classList.toggle("es-abierto");
    boton.setAttribute("aria-expanded", abierto ? "true" : "false");
    document.body.style.overflow = abierto ? "hidden" : "";
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape") cerrarMenu();
  });

  const enlacesNav = menu ? Array.from(menu.querySelectorAll("[data-nav-enlace]")) : [];

  enlacesNav.forEach((enlace) => {
    enlace.addEventListener("click", cerrarMenu);
  });

  // Indicador de sección activa mientras se hace scroll.
  const secciones = enlacesNav
    .map((enlace) => document.querySelector(enlace.getAttribute("href") || ""))
    .filter((el) => el);

  if (secciones.length && "IntersectionObserver" in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          const id = `#${entrada.target.id}`;
          enlacesNav.forEach((enlace) => {
            enlace.classList.toggle("es-activo", enlace.getAttribute("href") === id);
          });
        });
      },
      { rootMargin: "-40% 0px -55% 0px", threshold: 0 }
    );

    secciones.forEach((seccion) => seccion && observador.observe(seccion));
  }
</script>
