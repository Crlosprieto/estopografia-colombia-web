---
import { sitio, whatsappUrl } from "../data/sitio.js";
import SelloCertificacion from "./SelloCertificacion.astro";

const navegacion = [
  { texto: "Casos", href: "#casos" },
  { texto: "Sobre mí", href: "#sobre-mi" },
  { texto: "Equipos", href: "#equipos" },
  { texto: "Trabajos", href: "#trabajos" },
];

// Fecha real de esta publicación (se calcula al hacer `npm run build`, no es
// un dato inventado ni una fecha que cambie sola con el tiempo real).
const actualizadoCrudo = new Date().toLocaleDateString("es-CO", {
  month: "long",
  year: "numeric",
});
const actualizado = actualizadoCrudo.charAt(0).toUpperCase() + actualizadoCrudo.slice(1);
---

<footer id="contacto" class="footer">
  <div class="curvas-nivel-fondo curvas-nivel-fondo--sutil curvas-nivel-fondo--clara" aria-hidden="true"></div>

  <div class="contenedor footer__cta">
    <span class="footer__cta-etiqueta">05 / Contacto</span>
    <h2 class="footer__cta-titulo">{sitio.footerCtaTitulo}</h2>
    <p class="footer__cta-subtitulo">{sitio.footerCtaSubtitulo}</p>
    <a class="btn btn-primario footer__cta-boton" href={whatsappUrl(sitio.mensajeWhatsAppGenerico)} target="_blank" rel="noopener noreferrer">
      <span>Hablemos por WhatsApp</span>
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
        <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <p class="footer__cta-nota">Le contesto yo mismo, {sitio.nombreCorto} — no un bot ni un call center.</p>
  </div>

  <div class="contenedor footer__grid">
    <div class="footer__col footer__col--marca">
      <p class="footer__marca">{sitio.nombreComercial}</p>
      <p class="texto-muted">{sitio.nombre} · {sitio.matricula}</p>
      <p class="texto-muted footer__descripcion">{sitio.heroSubtitulo}</p>
    </div>

    <div class="footer__col">
      <span class="footer__col-titulo">Navegación</span>
      {navegacion.map((enlace) => <a href={enlace.href}>{enlace.texto}</a>)}
    </div>

    <div class="footer__col">
      <span class="footer__col-titulo">Servicios</span>
      {sitio.casos.map((caso) => <a href={`#${caso.slug}`}>{caso.titulo}</a>)}
    </div>

    <div class="footer__col">
      <span class="footer__col-titulo">Contacto</span>
      <a href={`tel:+${sitio.whatsapp}`}>{sitio.telefonoDisplay}</a>
      <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
      <p class="texto-muted footer__cobertura">{sitio.coberturaDetalle}</p>
    </div>
  </div>

  <div class="contenedor footer__firma fade-in-scroll">
    <SelloCertificacion class="footer__sello" />
    <div class="footer__firma-texto">
      <p class="footer__firma-etiqueta">Topógrafo certificado · {sitio.matricula}</p>
      <span class="footer__coordenadas" aria-hidden="true">4°20′ N · 74°22′ O</span>
    </div>
  </div>

  <div class="contenedor footer__legal">
    <p class="texto-muted">
      © {new Date().getFullYear()} {sitio.nombreComercial}. Licencia {sitio.matricula} vigente ante el {sitio.matriculaEntidad}.
      Sitio actualizado en {actualizado}.
    </p>
    <p class="texto-muted footer__privacidad">{sitio.avisoPrivacidad}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 0;
    overflow: hidden;
    background: var(--color-principal-dark);
    color: #d9dde5;
  }

  .footer a {
    color: #fff;
    text-decoration: none;
    transition: color var(--transicion);
  }

  .footer a:hover {
    color: var(--color-acento);
  }

  .footer .texto-muted {
    color: #939cae;
  }

  /* --- Banda de CTA -------------------------------------------------------- */
  .footer__cta {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 3.5rem);
    max-width: 42rem;
  }

  .footer__cta-etiqueta {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--paso--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-acento);
    margin-bottom: 1rem;
  }

  .footer__cta-etiqueta::before {
    content: "";
    display: inline-block;
    width: 13px;
    height: 13px;
    background: url("/img/marca-firma.svg") center / contain no-repeat;
    flex-shrink: 0;
  }

  .footer__cta-titulo {
    font-size: var(--paso-4);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #fff;
    margin-bottom: 0.6rem;
  }

  .footer__cta-subtitulo {
    color: #c3c9d6;
    font-size: var(--paso-1);
    max-width: 32rem;
    margin-bottom: 1.75rem;
  }

  .footer__cta-nota {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    font-style: italic;
    color: #7d879c;
  }

  /* --- Columnas -------------------------------------------------------------- */
  .footer__grid {
    display: grid;
    gap: 2.25rem;
    padding-block: 2.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer__col-titulo {
    font-size: var(--paso--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7d879c;
    margin-bottom: 0.35rem;
  }

  .footer__marca {
    font-family: var(--font-display);
    font-size: var(--paso-2);
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .footer__descripcion {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 26rem;
  }

  .footer__cobertura {
    font-size: 0.88rem;
    line-height: 1.6;
    margin-top: 0.15rem;
  }

  .footer p {
    margin: 0;
  }

  /* --- Firma / cierre memorable ------------------------------------------- */
  .footer__firma {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .footer__sello {
    flex-shrink: 0;
    width: clamp(64px, 9vw, 96px);
    height: clamp(64px, 9vw, 96px);
  }

  .footer__sello :global(svg) {
    width: 100%;
    height: 100%;
  }

  .footer__firma-texto {
    min-width: 0;
  }

  .footer__firma-etiqueta {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #939cae;
    margin-bottom: 0.4rem;
  }

  .footer__coordenadas {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 9vw, 7rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.13);
  }

  @media (min-width: 480px) {
    .footer__coordenadas {
      white-space: nowrap;
    }
  }

  /* --- Legal ----------------------------------------------------------------- */
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
  }

  .footer__privacidad {
    font-size: 0.76rem;
    max-width: 60rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 1.5rem;
    }
  }
</style>
