---
// El sello de un plano topográfico certificado, como firma visual del sitio:
// un anillo tipo dial de teodolito que se traza solo la primera vez que entra
// en pantalla (reutiliza el observer de .fade-in-scroll ya existente, sin JS
// nuevo) y una mira central — el mismo símbolo que aparece, en miniatura,
// junto a cada numeral de sección del sitio.
interface Props {
  class?: string;
}

const { class: clase = "" } = Astro.props;

const R_ANILLO = 46;
const CIRCUNFERENCIA = 2 * Math.PI * R_ANILLO;
const TICKS = Array.from({ length: 24 }, (_, i) => {
  const angulo = (i * 15 * Math.PI) / 180;
  const esMayor = i % 6 === 0;
  const rExterior = 38;
  const rInterior = esMayor ? 32 : 35;
  return {
    x1: 60 + rExterior * Math.cos(angulo),
    y1: 60 + rExterior * Math.sin(angulo),
    x2: 60 + rInterior * Math.cos(angulo),
    y2: 60 + rInterior * Math.sin(angulo),
  };
});
---

<div class={`sello ${clase}`}>
  <svg viewBox="0 0 120 120" width="96" height="96" aria-hidden="true" focusable="false">
    <circle
      class="sello__anillo"
      cx="60"
      cy="60"
      r={R_ANILLO}
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-dasharray={CIRCUNFERENCIA}
      stroke-dashoffset={CIRCUNFERENCIA}
      transform="rotate(-90 60 60)"
    />
    <g class="sello__ticks" stroke="currentColor" stroke-width="1" opacity="0.55">
      {TICKS.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
      ))}
    </g>
    <circle cx="60" cy="60" r="7" fill="none" stroke="currentColor" stroke-width="1.3" />
    <line x1="60" y1="44" x2="60" y2="50" stroke="currentColor" stroke-width="1.3" />
    <line x1="60" y1="70" x2="60" y2="76" stroke="currentColor" stroke-width="1.3" />
    <line x1="44" y1="60" x2="50" y2="60" stroke="currentColor" stroke-width="1.3" />
    <line x1="70" y1="60" x2="76" y2="60" stroke="currentColor" stroke-width="1.3" />
  </svg>
</div>

<style>
  .sello {
    color: rgba(255, 255, 255, 0.55);
    display: inline-flex;
  }

  .sello__anillo {
    transition: stroke-dashoffset 1400ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  :global(.fade-in-scroll.es-visible) .sello__anillo {
    stroke-dashoffset: 0;
  }

  .sello__ticks {
    opacity: 0;
    transition: opacity 600ms ease 1200ms;
  }

  :global(.fade-in-scroll.es-visible) .sello__ticks {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .sello__anillo,
    .sello__ticks {
      transition: none;
      stroke-dashoffset: 0;
      opacity: 0.55;
    }
  }
</style>
