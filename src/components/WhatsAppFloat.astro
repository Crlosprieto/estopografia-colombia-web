---
import { sitio, whatsappUrl } from "../data/sitio.js";
---

<a
  class="whatsapp-flotante"
  id="whatsapp-flotante"
  href={whatsappUrl(sitio.mensajeWhatsAppGenerico)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Hablar por WhatsApp"
>
  <svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.35.66 4.55 1.8 6.43L4 29l7.73-1.75a12.9 12.9 0 0 0 4.29.75h.01c6.62 0 12.02-5.4 12.02-12.02C28.05 8.4 22.65 3 16.02 3zm7.03 17.2c-.3.83-1.7 1.58-2.35 1.66-.6.08-1.35.11-2.18-.14-.5-.15-1.15-.37-1.98-.72-3.48-1.5-5.75-5.02-5.93-5.25-.17-.24-1.42-1.89-1.42-3.6 0-1.71.9-2.55 1.22-2.9.32-.34.7-.43.93-.43.23 0 .47 0 .67.01.22.01.5-.08.78.6.3.7 1.02 2.42 1.1 2.6.09.17.15.38.03.61-.12.23-.18.38-.36.58-.18.2-.38.45-.54.6-.18.18-.37.37-.16.72.2.35.9 1.5 1.95 2.43 1.34 1.2 2.47 1.57 2.83 1.75.36.18.57.15.78-.09.21-.24.9-1.05 1.14-1.41.24-.36.48-.3.79-.18.32.12 2.03.96 2.38 1.13.35.18.58.26.67.41.09.15.09.85-.2 1.68z"
    ></path>
  </svg>
  <span class="whatsapp-flotante__texto">Hablemos por WhatsApp</span>
</a>

<style>
  .whatsapp-flotante {
    position: fixed;
    right: max(1.1rem, env(safe-area-inset-right, 0px) + 0.75rem);
    bottom: max(1.1rem, env(safe-area-inset-bottom, 0px) + 0.75rem);
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem;
    border-radius: 999px;
    background: var(--color-acento);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 6px 20px rgba(176, 141, 62, 0.4);
    animation: pulso 2.2s ease-out 1s 3;
    transition: background-color var(--transicion), transform var(--transicion),
      opacity 400ms ease, visibility 0s linear 0s;
  }

  .whatsapp-flotante.esta-oculto {
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
  }

  .whatsapp-flotante svg {
    flex-shrink: 0;
  }

  .whatsapp-flotante__texto {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 300ms ease, opacity 300ms ease, padding-right 300ms ease;
  }

  @media (min-width: 560px) {
    .whatsapp-flotante__texto {
      max-width: 11rem;
      opacity: 1;
      padding-right: 0.2rem;
    }
  }

  .whatsapp-flotante:hover {
    background: var(--color-acento-dark);
    transform: translateY(-3px);
  }

  @keyframes pulso {
    0%,
    100% {
      box-shadow: 0 6px 20px rgba(176, 141, 62, 0.4);
    }
    50% {
      box-shadow: 0 6px 20px rgba(176, 141, 62, 0.4), 0 0 0 9px rgba(176, 141, 62, 0.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-flotante {
      animation: none;
    }

    .whatsapp-flotante:hover {
      transform: none;
    }
  }
</style>

<script>
  // Se atenúa cuando el pie de página (que ya tiene su propio CTA grande)
  // entra en pantalla, para no competir con él ni tapar contenido.
  const boton = document.getElementById("whatsapp-flotante");
  const pie = document.querySelector("footer");

  if (boton && pie && "IntersectionObserver" in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          boton.classList.toggle("esta-oculto", entrada.isIntersecting);
        });
      },
      { threshold: 0.15 }
    );
    observador.observe(pie);
  }
</script>
