---
import { sitio, whatsappUrl } from "../data/sitio.js";
---

<section class="no-encontro fade-in-scroll">
  <div class="contenedor no-encontro__caja">
    <h2 class="no-encontro__titulo">¿No encontró su caso?</h2>
    <p>
      Cada predio es distinto. Cuéntele a {sitio.nombreCorto} su situación por WhatsApp
      y le orienta sin compromiso.
    </p>
    <a class="btn btn-primario" href={whatsappUrl(sitio.mensajeWhatsAppGenerico)} target="_blank" rel="noopener noreferrer">
      Hablemos por WhatsApp
    </a>
  </div>
</section>

<style>
  .no-encontro__caja {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .no-encontro__titulo {
    font-size: var(--paso-3);
  }
</style>
