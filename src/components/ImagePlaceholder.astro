---
// Placeholder elegante para espacios donde falta la foto real. Respeta
// exactamente el tamaño/proporción final (a través del contenedor que lo
// envuelve) para que sustituir la foto después no mueva nada del layout:
// basta con cambiar la extensión del archivo en sitio.js.
interface Props {
  etiqueta?: string;
  alt: string;
}

const { etiqueta = "Foto pendiente", alt } = Astro.props;
---

<div class="img-placeholder" role="img" aria-label={alt}>
  <div class="img-placeholder__contenido">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="7" width="18" height="13" rx="2" />
      <path d="M8 7l1.3-2.2A1.8 1.8 0 0110.8 4h2.4a1.8 1.8 0 011.5.8L16 7" />
      <circle cx="12" cy="13.5" r="3.4" />
    </svg>
    <span class="img-placeholder__etiqueta">{etiqueta}</span>
  </div>
</div>

<style>
  .img-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--color-bg-alt), var(--color-bg));
    overflow: hidden;
  }

  .img-placeholder::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px dashed var(--color-borde);
    pointer-events: none;
  }

  .img-placeholder__contenido {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .img-placeholder__contenido svg {
    color: var(--color-acento);
    opacity: 0.75;
  }

  .img-placeholder__etiqueta {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
</style>
